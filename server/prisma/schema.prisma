// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  MEMBER
}

enum BorrowStatus {
  PENDING
  BORROWING
  RETURNED
  REJECTED
  CANCELLED
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  email    String @unique
  fullName String @default("")
  password String
  phone    String?

  memberCode String? @unique

  role     Role    @default(STAFF)
  isActive Boolean @default(true)

  mustChangePassword          Boolean   @default(false)
  passwordSetupTokenHash      String?
  passwordSetupTokenExpiresAt DateTime?

  passwordResetTokenHash      String?
  passwordResetTokenExpiresAt DateTime?

  borrowRecords          BorrowRecord[] @relation("MemberBorrowRecords")
  processedBorrowRecords BorrowRecord[] @relation("StaffBorrowRecords")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?

  books Book[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Book {
  id               Int       @id @default(autoincrement())
  title            String
  isbn             String    @unique
  author           String
  publisher        String?
  publishedDate    DateTime?
  description      String?
  price            Decimal   @db.Decimal(10, 2)
  quantity         Int       @default(0)
  borrowedQuantity Int       @default(0)
  coverImage       String?

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  borrowRecords BorrowRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@index([author])
  @@index([categoryId])
}

model BorrowRecord {
  id Int @id @default(autoincrement())

  memberId Int
  member   User @relation("MemberBorrowRecords", fields: [memberId], references: [id], onDelete: Restrict)

  bookId Int
  book   Book @relation(fields: [bookId], references: [id], onDelete: Restrict)

  borrowedAt DateTime  @default(now())
  dueDate    DateTime
  returnedAt DateTime?

  status       BorrowStatus @default(PENDING)
  notes        String?
  rejectReason String?
  renewCount   Int          @default(0)

  processedById Int?
  processedBy   User? @relation("StaffBorrowRecords", fields: [processedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
  @@index([memberId])
  @@index([processedById])
  @@index([status])
}
